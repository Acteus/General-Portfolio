---
interface Props {
  href?: string;
  label: string;
  statusLabel: string;
}

const { href, label, statusLabel } = Astro.props;
---

{href ? (
  <a class="verified-link" href={href} target="_blank" rel="noopener noreferrer">{label}</a>
) : (
  <span class="verified-link verified-link--pending" role="status">{statusLabel}</span>
)}
