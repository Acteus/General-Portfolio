---
interface Props {
  label: string;
  value: string;
  sourcePath?: string;
  kind?: string;
}

const { label, value, sourcePath, kind = 'evidence' } = Astro.props;
---

<article class="evidence-artifact" data-evidence-kind={kind}>
  <p class="evidence-artifact__label">{label}</p>
  <p class="evidence-artifact__value">{value}</p>
  {sourcePath ? <code class="evidence-artifact__source">{sourcePath}</code> : null}
</article>
