---
import type { CollectionEntry } from 'astro:content';
import JournalChapter from './JournalChapter.astro';

type Project = CollectionEntry<'projects'>;
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const journalProjects = projects.filter((project) => project.data.themeAvailability === 'both');
---

<section class="mode-section journal-mode" data-mode="journal" aria-labelledby="journal-heading">
  <header class="hero journal-hero" id="home-journal">
    <p class="eyebrow">Personal workspace · learning in public</p>
    <h1 id="journal-heading">Field Journal</h1>
    <p class="hero__lede">A quiet corner for the systems I’m building, the lessons I’m keeping, and the questions I’m still exploring—usually with coffee nearby.</p>
    <div class="hero__actions"><a class="button button--primary" href="#journal-projects">Read my notes</a><a class="button" href="#journal-now">What I’m working on</a></div>
  </header>
  <section class="content-section" id="journal-story" aria-labelledby="journal-story-heading"><header class="section-heading"><p class="eyebrow">The person behind the terminal</p><h2 id="journal-story-heading">My story</h2></header><div class="prose">{['I’m an IT student who became interested not only in writing applications, but in the quieter work that keeps them reachable: packaging, deployment, service connections, logs, and recovery.', 'This space is a record of learning through real systems across Azure, DigitalOcean, and Oracle Cloud—what worked, what needed another attempt, and what I want to understand better next.'].map((paragraph) => <p>{paragraph}</p>)}</div></section>
  <section class="content-section" id="journal-now" aria-labelledby="journal-now-heading"><header class="section-heading"><p class="eyebrow">What has my attention</p><h2 id="journal-now-heading">Now</h2></header><div class="cards-grid">{[
    { tier: 'Building', title: 'JRU Atlas & LaborWise', body: 'Two private systems in active development: an accreditation workspace on DigitalOcean and an employment-rights service on Azure.', technologies: ['DigitalOcean', 'Azure', 'Private projects'] },
    { tier: 'Learning', title: 'Making operations visible', body: 'I’m paying closer attention to observability, reliable container delivery, and documentation that explains what happens after deployment.', technologies: ['Observability', 'Containers', 'Documentation'] },
    { tier: 'Improving', title: 'Sharing the work responsibly', body: 'I’m turning deployment work into concise, sanitized case studies that show decisions and lessons without exposing private code or data.', technologies: ['Case studies', 'Architecture', 'Clear writing'] },
  ].map((item) => <article class="info-card"><p class="eyebrow">{item.tier}</p><h3>{item.title}</h3><p>{item.body}</p><ul class="tag-list">{item.technologies.map((technology) => <li>{technology}</li>)}</ul></article>)}</div></section>
  <section class="content-section" id="journal-projects" aria-labelledby="journal-projects-heading"><header class="section-heading"><p class="eyebrow">Lessons worth keeping</p><h2 id="journal-projects-heading">Notes</h2></header><div class="journal-list">{journalProjects.map((project, index) => <JournalChapter project={project} chapterNumber={index + 1} />)}</div></section>
  <section class="content-section contact-section" id="journal-contact" aria-labelledby="journal-contact-heading"><header class="section-heading"><p class="eyebrow">Pull up a chair</p><h2 id="journal-contact-heading">Say hello</h2></header><div class="contact-layout"><p>If you’re building something thoughtful, learning through a difficult system, or looking for someone who cares about the details behind deployment, I’d be glad to hear from you.</p><div class="hero__actions"><a class="button button--primary" href="mailto:garrendullas@gmail.com">Email Garren</a><a class="button" href="https://github.com/Acteus" target="_blank" rel="noopener noreferrer">GitHub</a></div></div></section>
</section>
