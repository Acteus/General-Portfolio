---
import type { CollectionEntry } from 'astro:content';
import ArchitectureArtifact from '../ui/ArchitectureArtifact.astro';
import EvidenceArtifact from '../ui/EvidenceArtifact.astro';
import CaseStudySpread from './CaseStudySpread.astro';
import StatusLabel from '../ui/StatusLabel.astro';
import VerifiedLink from '../ui/VerifiedLink.astro';

type Project = CollectionEntry<'projects'>;
interface Props {
  project: Project;
  chapterNumber: number;
}

const { project, chapterNumber } = Astro.props;
const { data } = project;
const archiveAudit = project.id === 'project-archive' ? (await import('../../data/project-archive-evidence.json')).default : null;
---

<details class="journal-chapter" id={`chapter-${project.id}`} data-journal-chapter={project.id} open={project.id === 'project-archive'}>
  <summary class="journal-chapter__cover">
    <span class="chapter-number">Chapter {String(chapterNumber).padStart(2, '0')}</span>
    <strong>{data.title}</strong>
    <span>{data.chapterType === 'flagship' ? 'When source material becomes a system people can question.' : data.recruiterSummary}</span>
  </summary>
  <div class="journal-chapter__body">
    <div class="journal-chapter__meta"><span>{data.role} · {data.date}</span><StatusLabel status={data.status} label={data.statusLabel} /></div>
    <section class="journal-block" aria-labelledby={`${project.id}-story`}><h3 id={`${project.id}-story`}>The story</h3>{data.story.map((paragraph) => <p>{paragraph}</p>)}</section>
    <section class="journal-block" aria-labelledby={`${project.id}-technical`}><h3 id={`${project.id}-technical`}>Under the hood</h3>{data.technicalNarrative.map((paragraph) => <p>{paragraph}</p>)}{data.architecture?.length ? <ArchitectureArtifact label={`${data.title} architecture`} steps={data.architecture} /> : null}</section>
    {data.evidence.length ? <section class="journal-block" aria-labelledby={`${project.id}-evidence`}><h3 id={`${project.id}-evidence`}>Evidence</h3><div class="evidence-grid">{data.evidence.map((item) => <EvidenceArtifact kind={item.kind} label={item.label} value={item.value} sourcePath={item.sourcePath} />)}</div></section> : null}
    {data.spreads.length ? <section class="journal-block journal-block--spreads" aria-labelledby={`${project.id}-spreads`}><h3 id={`${project.id}-spreads`}>Five spreads</h3>{data.spreads.map((spread, index) => project.id === 'project-archive' && archiveAudit ? <CaseStudySpread id={spread.id} question={spread.question} narrative={spread.narrative} position={index + 1} total={data.spreads.length} sourceCommit={archiveAudit.sourceCommit} artifact={(['record', 'architecture', 'citations', 'operations', 'doorway'] as const)[index]} /> : <article class="journal-spread"><p class="eyebrow">Spread {index + 1} of {data.spreads.length}</p><h4>{spread.question}</h4>{spread.narrative.map((paragraph) => <p>{paragraph}</p>)}<ul class="evidence-list">{spread.artifactIds.map((artifact) => <li>{artifact}</li>)}</ul></article>)}</section> : null}
    <section class="journal-block" aria-labelledby={`${project.id}-technologies`}><h3 id={`${project.id}-technologies`}>Technologies</h3><ul class="tag-list">{data.technologies.map((technology) => <li>{technology}</li>)}</ul></section>
    <footer class="journal-chapter__footer"><StatusLabel status={data.status} label={data.statusLabel} />{data.links.length ? data.links.map((link) => <VerifiedLink href={link.href} label={link.label} statusLabel={data.statusLabel} />) : <VerifiedLink label={data.statusLabel} statusLabel={data.statusLabel} />}</footer>
  </div>
</details>
