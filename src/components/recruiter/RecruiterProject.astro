---
import type { CollectionEntry } from 'astro:content';
import StatusLabel from '../ui/StatusLabel.astro';
import VerifiedLink from '../ui/VerifiedLink.astro';

type Project = CollectionEntry<'projects'>;
interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
---

<article class:list={['recruiter-project', { 'recruiter-project--flagship': data.chapterType === 'flagship' }]} id={`recruiter-${project.id}`}>
  <header class="recruiter-project__header">
    <div><StatusLabel status={data.status} label={data.statusLabel} /><h3>{data.title}</h3><p class="recruiter-project__role">{data.role} · {data.date}</p></div>
  </header>
  <p class="recruiter-project__summary">{data.recruiterSummary}</p>
  <ul class="recruiter-project__proof" aria-label={`${data.title} verified proof`}>
    {data.verifiedClaims.map((claim) => <li>{claim}</li>)}
  </ul>
  <ul class="tag-list" aria-label={`${data.title} technologies`}>
    {data.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <footer class="recruiter-project__footer">
    {data.links.length ? data.links.map((link) => <VerifiedLink href={link.href} label={link.label} statusLabel={data.statusLabel} />) : <VerifiedLink label={data.statusLabel} statusLabel={data.statusLabel} />}
  </footer>
</article>
