---
interface TrailItem {
  label: string;
  value: string;
  sourcePath: string;
  sourceClaimId: string;
}

interface Props {
  items: TrailItem[];
}

const { items } = Astro.props;
---

<ol class="operations-trail" data-artifact="operations">
  {items.map((item) => <li><span class="operations-trail__label">{item.label}</span><strong>{item.value}</strong><code data-source-claim={item.sourceClaimId}>{item.sourcePath}</code></li>)}
</ol>
