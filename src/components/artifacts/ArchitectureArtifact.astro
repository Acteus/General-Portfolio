---
interface Props {
  label?: string;
  steps: string[];
  sourcePaths?: string[];
}

const { label = 'Architecture path', steps, sourcePaths = [] } = Astro.props;
---

<figure class="architecture-artifact" data-artifact="architecture">
  <figcaption class="architecture-artifact__label">{label}</figcaption>
  <ol>{steps.map((step) => <li>{step}</li>)}</ol>
  {sourcePaths.length ? <div class="artifact-source-list">{sourcePaths.map((path) => <code>{path}</code>)}</div> : null}
</figure>
